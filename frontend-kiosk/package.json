{
  "name": "kronoqr-kiosk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.vitest.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run --coverage",
    "api:generate": "node scripts/generate-api-client.mjs",
    "e2e:fixtures": "node scripts/generate-qr-fixture.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@kronoqr/web-kit": "*",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "dexie": "^4.4.4",
    "libsodium-wrappers": "^0.8.4",
    "pinia": "^2.3.1",
    "vue": "^3.5.41",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.6.4",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.9"
  }
}
