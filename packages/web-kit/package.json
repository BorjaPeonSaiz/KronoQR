{
  "name": "@kronoqr/web-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./eslint/identifier-language": "./eslint/identifier-language.js",
    "./eslint/no-browser-storage": "./eslint/no-browser-storage.js",
    "./eslint/no-bare-strings": "./eslint/no-bare-strings.js",
    "./eslint/no-literal-colors": "./eslint/no-literal-colors.js",
    "./theme.css": "./src/theme.css",
    "./base.css": "./src/base.css",
    "./fonts.css": "./src/fonts.css",
    "./components/*": "./src/components/*",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "type-check": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.vitest.json",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run --coverage"
  },
  "peerDependencies": {
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@zxing/library": "^0.23.0"
  }
}
