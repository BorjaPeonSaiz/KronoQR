# Secretos y configuración local (doc 02 §7.7: nada de secretos en el repositorio).
.env
.env.*
!.env.example
*.pem
*.key
*.crt
infra/docker/nginx/certs/

# Dependencias
/backend/vendor/
node_modules/

# Artefactos de ejecución
#
# storage/ y bootstrap/cache/ NO se ignoran enteros: Laravel versiona el
# esqueleto de directorios con un .gitignore dentro de cada uno que ignora el
# contenido y conserva la carpeta. Ignorarlos aquí de golpe dejaba una
# instalación limpia sin storage/framework/{cache,sessions,views}, y la
# aplicación no arranca sin esas carpetas.
/backend/public/hot
/backend/public/build/
dist/
coverage/
.phpunit.result.cache
.phpunit.cache/
/load-tests/k6/results/

# SBOM generado por `make sbom` (doc 02 §9.2). Se sube como artefacto de cada
# ejecucion de la CI, no se versiona: es un derivado de composer.lock y
# package-lock.json, que si estan versionados.
/sbom/

# Herramientas de desarrollo
.idea/
.vscode/
.fleet/
*.log
.DS_Store
Thumbs.db
