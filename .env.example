#==============================================================================
# KronoQR - plantilla de configuracion
#==============================================================================
# Copia este fichero a .env (make up lo hace solo la primera vez) y rellena lo
# que corresponda. Este fichero se versiona; .env NO se versiona nunca.
#
# Regla que gobierna todo lo de abajo (doc 02 §7.7): NADA DE SECRETOS EN EL
# REPOSITORIO. En desarrollo, los valores marcados como "solo desarrollo" son
# placeholders sin valor fuera de tu maquina. En produccion, install.sh genera
# los secretos EN EL SERVIDOR DEL CLIENTE y no los transmite a nadie.
#
# Como generar un valor aleatorio de 32 bytes en base64:
#   openssl rand -base64 32
#
# UNA VARIABLE VACIA NO LLEVA COMENTARIO EN SU MISMA LINEA. Docker Compose
# recorta el comentario cuando la variable tiene valor, pero cuando esta vacia
# le asigna el comentario COMO VALOR: REDIS_PASSWORD acababa valiendo
# "# Vacio en desarrollo...", y el fallo aparece lejos de aqui, como un error
# de autenticacion de Redis. El comentario va en la linea de encima.
#
#==============================================================================
# LAS TRES CATEGORIAS. Antes de tocar nada, mira la marca.
#==============================================================================
#
#   [CLIENTE]      LO RELLENAS TU, antes de ejecutar install.sh. Son las
#                  decisiones de esta instalacion concreta: la URL, las redes,
#                  el certificado, el destino de las copias, el correo, la
#                  licencia. El instalador comprueba en su fase 1 que estan y
#                  se niega a instalar si falta alguna.
#
#   [INSTALADOR]   LO GENERA install.sh EN ESTE SERVIDOR y no lo transmite a
#                  nadie (doc 02 §7.7, RS-08). Dejalo vacio: si escribes algo
#                  aqui, el instalador lo sustituye. El fabricante no conoce
#                  estos valores y no puede recuperarlos.
#
#   [FIJO]         No se toca. Cambiarlo rompe algo que no se parece a este
#                  fichero.
#
#   Sin marca      Tiene un valor por defecto pensado y la mayoria de las
#                  instalaciones no lo cambia nunca. Cada uno esta explicado en
#                  docs/cliente/configuracion.md. Si dudas, dejalo como esta.
#
# EN DESARROLLO este mismo fichero es la plantilla que copia `make up`, con
# APP_ENV=local. Los valores marcados "SOLO DESARROLLO" son placeholders sin
# valor fuera de tu maquina.
#==============================================================================


#------------------------------------------------------------------------------
# Aplicacion
#------------------------------------------------------------------------------
APP_NAME=KronoQR
# [CLIENTE] `production` en el servidor de un hotel. En desarrollo, `local`.
APP_ENV=local
# [CLIENTE] SIEMPRE false en produccion. Con true, cualquier error muestra la
# traza y la configuracion —incluidas claves— a quien lo provoque, y eso en un
# sistema con datos de jornada de toda la plantilla no es un detalle.
#
# La aplicacion SE NIEGA A ARRANCAR con APP_ENV=production y APP_DEBUG=true, y
# dice como corregirlo (App\Support\Environment\ProductionSafetyGuard). El
# valor de serie es false porque el valor por defecto ES el producto: quien
# desarrolle y quiera la traza la enciende a mano en su .env local.
APP_DEBUG=false
# Clave de cifrado de la aplicacion. Generala y pegala aqui:
#   docker compose --env-file .env -f infra/compose.dev.yaml exec -T app \
#     php artisan key:generate --show
# Con --show a proposito: la aplicacion lee su configuracion del entorno del
# contenedor, no de un backend/.env, asi que artisan no tiene fichero que
# reescribir. En produccion la genera install.sh en el servidor del cliente.
# [INSTALADOR]
APP_KEY=
# [CLIENTE] La URL https por la que los quioscos y el panel llegan a este
# servidor. Tiene que coincidir con el nombre del certificado TLS.
APP_URL=https://localhost

# [FIJO] Regla dura 3: TODO instante se almacena en UTC. La zona horaria de
# presentacion es un atributo de cada centro (sites.timezone), nunca del
# proceso. Cambiar esto invalida el calculo de jornada (RN-04, RN-05, ADR-004)
# y deja el registro horario sin valor legal. El instalador no ofrece cambiarlo.
APP_TIMEZONE=UTC

# Idioma de los documentos que genera el SERVIDOR: la exportacion legal para
# Inspeccion (tarea 1.17), el informe de horas descargado (2.9), los PDF de
# tarjetas. No es el idioma del panel —ese lo elige cada persona en su
# navegador—, es el de un fichero que se entrega a un tercero, y por eso es
# configuracion de la instalacion y no una constante (regla dura 13, ADR-017).
# Tambien es el idioma de respaldo de la API cuando el navegador pide uno que
# la instalacion no ofrece. Traducciones disponibles: es, en.
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# Idiomas que la API acepta negociar con `Accept-Language` para lo que lee una
# persona en pantalla (mensajes de validacion, criterios de un informe). Lista
# separada por comas, subconjunto de las traducciones disponibles. Que exista
# la traduccion no basta: cada instalacion ofrece los idiomas que decide. La
# tarea 5.8 lo lleva a la configuracion de la instalacion.
APP_SUPPORTED_LOCALES=es,en


#------------------------------------------------------------------------------
# Base de datos - PostgreSQL 17
#------------------------------------------------------------------------------
#
# TRES ROLES, Y NO ES BUROCRACIA (tarea 1.14, regla dura 6, ADR-027).
#
# Un GRANT o un REVOKE sobre un SUPERUSUARIO de PostgreSQL es decorativo: el
# motor ni los comprueba. Mientras la aplicacion corrio con el rol de arranque
# del cluster, "el usuario de aplicacion no tiene UPDATE ni DELETE sobre
# audit_log" era una frase en un documento. Ahora son tres roles distintos:
#
#   fichaje_migrator     Propietario y unico con DDL. Ejecuta las MIGRACIONES.
#   fichaje_app          Runtime. Sin DDL. Sobre audit_log, solo INSERT+SELECT.
#   fichaje_maintenance  Retencion (tarea 2.10). Unico que suelta particiones.
#                        SIN CONTRASEÑA AQUI, a proposito: no es un rol de la
#                        aplicacion y su credencial no vive en este fichero.
#
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fichaje
DB_USERNAME=fichaje_app                # Sin DDL. Sin UPDATE/DELETE sobre audit_log (regla dura 6)
# [INSTALADOR]
DB_PASSWORD=kronoqr_local_dev_only     # SOLO DESARROLLO. En produccion lo genera install.sh

# Rol de migracion. Es POSTGRES_USER del contenedor y el propietario de todo.
# `php artisan migrate` corre sobre la conexion `pgsql_migrator`, que usa estas
# credenciales; la aplicacion en marcha no las toca nunca.
#
# En produccion se pueden dejar FUERA del entorno de los contenedores y pasarse
# solo al desplegar, que es cuando hacen falta:
#   docker compose run --rm -e DB_MIGRATION_PASSWORD=... app php artisan migrate --database=pgsql_migrator --force
DB_MIGRATION_USERNAME=fichaje_migrator
# [INSTALADOR]
DB_MIGRATION_PASSWORD=kronoqr_local_dev_only_migrator   # SOLO DESARROLLO

# Rol de mantenimiento (ADR-027, ADR-033). Se declara el nombre para que el
# script de roles lo cree; la CONTRASEÑA NO VA AQUI, y no es un descuido:
# es el unico rol que puede soltar una particion vencida de audit_log (tarea
# 2.10), y si la instalacion corriente pudiera autenticarse con el, el reparto
# de tres roles seria decorativo.
#
# La purga por retencion es manual y anual. Su credencial se aporta en el
# momento de ejecutarla, y solo entonces:
#
#   docker compose run --rm -e DB_MAINTENANCE_PASSWORD=... app \
#     php artisan compliance:apply-retention --confirm=PURGAR-...
#
# La SIMULACION (`--dry-run`), que es la que programa el planificador, no la
# necesita: solo cuenta, y cuenta con el rol de la aplicacion.
DB_MAINTENANCE_USERNAME=fichaje_maintenance
# DB_MAINTENANCE_PASSWORD=            # Vacia a proposito. Ver arriba.

# Usuario con el que se hacen las COPIAS. Es el de migracion y no el de la
# aplicacion por dos razones concretas: `pg_basebackup` exige el atributo
# REPLICATION y restaurar exige CREATEDB, y fichaje_app no tiene ninguno de los
# dos desde la tarea 1.14. Sin esto, la copia fisica que sostiene el RPO de 15
# minutos (RNF-D-02) fallaria en la primera ejecucion.
BACKUP_DB_USERNAME=fichaje_migrator
# [INSTALADOR]
BACKUP_DB_PASSWORD=kronoqr_local_dev_only_migrator      # SOLO DESARROLLO


#------------------------------------------------------------------------------
# Redis 7 - colas, cache, rate limiting, sesiones
#------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# Vacio en desarrollo (Redis no publica puerto al exterior)
REDIS_PASSWORD=
QUEUE_CONNECTION=redis                 # El fallback a base de datos de RNF-D-03 NO esta implementado: exige el driver failover y decidir quien consume la cola de respaldo junto a Horizon (Fase 3, anotado en HANDOFF). Hoy, si Redis cae, los trabajos asincronos esperan a que vuelva.
CACHE_STORE=redis
SESSION_DRIVER=redis


#------------------------------------------------------------------------------
# WebSocket de presencia en vivo - Laravel Reverb
#------------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb

# Identificador y clave PUBLICA de la aplicacion. La clave viaja al navegador en
# meta.realtime.key de GET /api/v1/attendance/live: identifica la aplicacion en
# el saludo del WebSocket y no autoriza nada por si sola. Valores de desarrollo;
# install.sh los genera en el servidor del cliente.
# [INSTALADOR]
REVERB_APP_ID=kronoqr-dev
# [INSTALADOR]
REVERB_APP_KEY=kronoqr-dev-key

# EL SECRETO. Firma la autorizacion de cada canal privado y las llamadas a la API
# de Reverb. NUNCA con valor en el repositorio, ni siquiera de desarrollo: se
# genera en la instalacion y sin el Reverb no arranca, que es el fallo ruidoso
# que se prefiere a uno silencioso con una clave conocida.
#   openssl rand -hex 32
# [INSTALADOR]
REVERB_APP_SECRET=

# Como llega el SERVIDOR a Reverb por la red interna de Docker. El navegador NO
# usa estos valores: llega por el mismo origen del panel, y Nginx proxifica /app/
# y /apps/ (ADR-017: sin CORS, nada especifico de un cliente compilado en la SPA).
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Origenes autorizados a abrir el WebSocket. Abierto por defecto porque el
# dominio de cada hotel lo pone el cliente y la defensa no esta aqui: todos los
# canales son privados y su suscripcion la firma el servidor con el alcance de
# quien pregunta. Un cliente que quiera cerrarlo mas pone su dominio.
# REVERB_ALLOWED_ORIGINS=panel.hotel.example

# Presencia en vivo vista desde el panel (ADR-011, ADR-023). Estos valores SALEN
# EN LA RESPUESTA de GET /api/v1/attendance/live: el panel no lleva ninguna
# variable VITE_* de tiempo real y no hay que recompilarlo por instalacion.
#
# REALTIME_ENABLED=false NO apaga la vista: la deja en sondeo cada
# REALTIME_POLL_INTERVAL_SECONDS, con aviso en pantalla (RNF-D-03). Es lo que se
# pone en un cliente cuyo proxy corporativo rompe los WebSockets.
REALTIME_ENABLED=true
REALTIME_POLL_INTERVAL_SECONDS=15
# REALTIME_PATH=/app                          # Ruta del WebSocket en el origen del panel
# REALTIME_AUTH_ENDPOINT=/api/v1/broadcasting/auth
# REALTIME_EVENT=presence.updated


#------------------------------------------------------------------------------
# Credencial QR (doc 02 §5)
#------------------------------------------------------------------------------
# [INSTALADOR]
QR_SIGNING_KEY_CURRENT_ID=a3           # Clave activa. Dos caracteres (§5.1)
# 32 bytes en base64. Se genera en el servidor
# [INSTALADOR]
QR_SIGNING_KEY_CURRENT=
# Solape de una rotacion (§5.3, RF-QR-07): la clave SALIENTE. Ya no firma nada,
# pero sigue verificando las tarjetas impresas con ella, y por eso la
# reimpresion se reparte en semanas en vez de hacerse en un solo dia.
#
# LAS DOS VAN VACIAS fuera de una rotacion, que es el estado normal. El ID se
# rellena solo al abrir una, junto con la clave: un ID sin clave no crea ningun
# solape —el llavero lo ignora— pero si confunde a quien lee este fichero.
#
# Rotar, en dos lineas: mueve aqui la clave que habia con su key_id, pon 32
# bytes nuevos y un key_id distinto en CURRENT, y ejecuta
# `php artisan credentials:rotate-key`. Cuando
# `credentials:status --key-id=<saliente>` no devuelva a nadie, ejecuta
# `php artisan credentials:retire-key <saliente>` y vuelve a vaciar estas dos.
# El procedimiento completo esta en docs/runbooks/rotacion-clave-qr.md.
QR_SIGNING_KEY_PREVIOUS_ID=
QR_SIGNING_KEY_PREVIOUS=
QR_ERROR_CORRECTION=Q                  # Tolerancia al desgaste de la tarjeta (RF-QR-05)
QR_SIZE_MM=26                          # Lado del QR impreso. Tamano minimo garantizado (RF-QR-05)

# Marca de la instalacion (RF-PD-08, regla dura 13). ESTAS TRES VARIABLES SON
# LAS QUE EL CODIGO LEE HOY (config/branding.php): las consumen la tarjeta
# impresa y la cabecera de la exportacion legal. Las tres son opcionales y
# ninguna trae una marca de serie: una tarjeta sin logotipo se imprime igual.
#
# LA TAREA 5.1 YA GUARDA LA MARCA EN `installation_settings`, editable desde el
# panel y auditada (GET/PATCH /api/v1/settings, claves BRANDING_APP_NAME,
# BRANDING_LOGO_PATH y BRANDING_ACCENT_COLOR). Todavia no la pinta nadie: la
# TAREA 5.8 pasa a esas claves los dos consumidores de arriba y decide si estas
# variables se renombran para que coincidan con ellas. Hasta entonces conviven,
# y la de aqui es la que se aplica.
# BRANDING_NAME=                       # Vacio = se imprime el nombre del centro
# BRANDING_LOGO_PATH=                  # Ruta ABSOLUTA en el servidor a un PNG o SVG
BRANDING_ACCENT_COLOR=#111827          # Notacion CSS #rrggbb

# Browsershot, que es lo que dibuja el PDF de las tarjetas (spatie/laravel-pdf,
# doc 02 §3.1). Las rutas son las de la imagen del producto: Chromium y Puppeteer
# vienen DENTRO (infra/docker/php/Dockerfile), no se descargan al arrancar.
#
# --no-sandbox porque el contenedor ya corre como usuario sin privilegios y sin
# capacidades adicionales: el sandbox de Chromium necesita user namespaces que el
# contenedor no concede, y el HTML que se le entrega no viene de fuera -lo genera
# la propia aplicacion, sin ninguna URL remota-.
LARAVEL_PDF_CHROME_PATH=/usr/bin/chromium-browser
LARAVEL_PDF_NODE_MODULES_PATH=/usr/local/lib/node_modules
LARAVEL_PDF_NO_SANDBOX=true

# Suelo de tiempo que consume TODO rechazo de credencial (RS-03, regla dura 17).
# Los cuatro rechazos -formato, clave, firma y credencial desconocida o
# revocada- recorren pasos distintos, y sin suelo la diferencia de microsegundos
# entre "no hay fila" y "hay fila revocada" se mide desde fuera. Subirlo endurece
# el control y anade latencia SOLO al rechazo; bajarlo a 0 lo desactiva y no
# deberia hacerse en produccion.
IDENTITY_CREDENTIAL_REJECTION_FLOOR_MS=25


#------------------------------------------------------------------------------
# Reglas de fichaje - umbrales configurables, nunca constantes en el codigo
#------------------------------------------------------------------------------
ATTENDANCE_DEBOUNCE_SECONDS=60         # RF-AT-06
ATTENDANCE_MAX_SHIFT_HOURS=12          # RN-08
ATTENDANCE_MAX_CLOCK_SKEW_MINUTES=15   # RF-AT-10. Genera incidencia, NUNCA rechaza el fichaje
ATTENDANCE_PATTERN_WINDOW_SECONDS=10   # RF-PR-06. Fichajes consecutivos en el mismo quiosco
ATTENDANCE_PATTERN_MIN_REPEATS=3       # RF-PR-06. Coincidencias antes de generar incidencia
ATTENDANCE_MIN_TRANSIT_SECONDS=120     # RN-16. Transito minimo entre dos quioscos distintos


#------------------------------------------------------------------------------
# Acceso al panel de gestion (RF-ID-01, doc 02 §7.3)
#------------------------------------------------------------------------------
# Bloqueo por intentos fallidos. NO es el rate limiting del §7.1: aquel cuenta
# peticiones por origen y lo aplican Nginx y la ruta; esto cuenta FALLOS por
# cuenta, que es lo que frena a quien prueba contrasenas contra un correo
# conocido desde muchas IP.
IDENTITY_LOGIN_MAX_ATTEMPTS=5
IDENTITY_LOGIN_LOCKOUT_SECONDS=900     # 15 min

# Vida del token del panel. Corta a proposito (§7.3). El token del quiosco dura
# 90 dias y no se ve afectado: la caducidad se fija token a token.
IDENTITY_SESSION_TOKEN_HOURS=12

# Longitud minima de la contrasena de gestion. La politica completa -mayusculas,
# minusculas, digitos y simbolos- se aplica al FIJARLA: en identity:create-user
# y en el primer administrador del asistente de puesta en marcha (tarea 5.5).
# Hay un suelo de 8 escrito en el codigo: por debajo no se puede bajar.
IDENTITY_PASSWORD_MIN_LENGTH=12

#------------------------------------------------------------------------------
# ASISTENTE DE PUESTA EN MARCHA - RF-PD-03, tarea 5.5
#------------------------------------------------------------------------------
# Peticiones por minuto y POR ORIGEN de las dos rutas publicas del asistente:
# GET /api/v1/setup/status y POST /api/v1/setup/administrator.
#
# ZONA PROPIA Y NO LA DE ACCESO, porque aquella cuenta por cuenta usando el
# correo del cuerpo y aqui no hay ninguna cuenta a la que contar: la que se va a
# crear todavia no existe. Compartirlas gastaria ademas el cupo de acceso de la
# persona que esta a punto de entrar.
#
# 10 deja margen de sobra para una puesta en marcha -que la hace una persona, una
# vez, consultando el estado entre paso y paso- y corta un bucle en el primer
# segundo. Subelo si la instalacion tiene NAT delante y el panel comparte IP con
# media oficina.
PRODUCT_SETUP_RATE_LIMIT=10

#------------------------------------------------------------------------------
# SEGUNDO FACTOR DE GESTION - RS-06, RF-ID-01, tarea 2.1
#------------------------------------------------------------------------------
# SOLO CUENTAS DE GESTION. El empleado no tiene ni puede tener TOTP: su
# credencial es una tarjeta fisica (ADR-014) y su acceso al portal es codigo y
# PIN (ADR-015).
#
# Roles obligados a llevarlo. De serie los tres de RS-06, que son los que
# alcanzan datos de TODA la plantilla; el responsable de departamento no entra
# porque su alcance esta acotado (RF-ID-03). Un cliente con una politica mas dura
# anade responsable_departamento aqui, sin tocar el repositorio.
# Quien ya lo activo sigue teniendo que presentarlo aunque su rol salga de esta
# lista: quitar la obligatoriedad no desactiva el segundo factor de nadie.
IDENTITY_2FA_REQUIRED_ROLES=admin,rrhh,auditor

# Vida de la SESION PENDIENTE entre /auth/login y /auth/2fa/verify, en minutos.
# Minutos y no horas: lo que esta abierto ahi es media autenticacion, y con las
# 12 h del panel una contrasena robada seria un acceso pendiente de un solo
# codigo durante toda la jornada.
IDENTITY_2FA_CHALLENGE_MINUTES=10

# Fallos de CODIGO antes de bloquear. Contador propio, distinto del de la
# contrasena: compartirlo dejaria sin reintentos de contrasena a quien gaste el
# cupo probando codigos, y permitiria doblar los intentos alternando las dos
# puertas.
IDENTITY_2FA_MAX_ATTEMPTS=5
IDENTITY_2FA_LOCKOUT_SECONDS=900       # 15 min

# Ventana de tolerancia, en franjas de 30 s a cada lado. Existe porque el reloj
# de un telefono se desvia; con 1, un codigo vale unos 90 s. Un cliente con
# relojes sincronizados por NTP puede bajarla a 0.
IDENTITY_2FA_WINDOW=1

# Longitud del secreto en caracteres base32. 32 son 160 bits.
IDENTITY_2FA_SECRET_LENGTH=32

# Emisor que aparece en el autenticador junto al correo de la cuenta. Es marca, y
# la marca es configuracion (ADR-017): un cliente con marca blanca pone la suya.
IDENTITY_2FA_ISSUER=KronoQR

# Peticiones por minuto a /auth/2fa/* por cuenta (dueno del reto pendiente),
# aparte del limite por IP. Zona propia, distinta de `auth` (que solo cubre
# /auth/login): con la de /auth/login, que se acota por correo del cuerpo, los
# tres endpoints del segundo factor compartian un unico cubo para toda la
# instalacion. Debe ser >= IDENTITY_2FA_MAX_ATTEMPTS para que el bloqueo por
# cuenta actue antes que el limitador.
IDENTITY_2FA_RATE_LIMIT=5

# Peticiones por minuto de las rutas de gestion que leen o corrigen datos de
# terceros (plantilla, registro horario, correcciones), por cuenta y por
# origen. Mismo techo que la zona «resto» de Nginx (doc 02 §7.1); lo que anade
# es el eje por cuenta, que el borde no puede aplicar.
IDENTITY_MANAGEMENT_RATE_LIMIT=120

# PIN del empleado (RF-ID-09). Seis digitos: la longitud NO es configurable
# porque el contrato la fija. Lo que si lo es son los PIN que el generador nunca
# emite -de serie, los repetidos y las secuencias- y el bloqueo por intentos, que
# es el de RS-12 y no el del panel: quien teclea mal en un quiosco a las 06:00 no
# es quien prueba contrasenas contra el panel. Restablecer el PIN limpia ese
# contador: quien pide uno nuevo tiene que poder usarlo en el momento.
# IDENTITY_PIN_FORBIDDEN se declara separado por comas y sustituye a la lista de
# serie completa; vacio significa "no excluir ninguno", que es una mala idea.
#IDENTITY_PIN_FORBIDDEN=000000,111111,123456
#
# BLOQUEO CRECIENTE, TRES ESCALONES (RS-12, doc 02 §7.5). Cada uno triplica al
# anterior: barrer un espacio de 10^6 es inviable y a quien se equivoca una vez
# no se le castiga como a quien esta probando. Son POR EMPLEADO Y POR ORIGEN: el
# contador del quiosco y el del portal son distintos, para que sondear una puerta
# no deje a nadie sin poder fichar por la otra.
IDENTITY_PIN_MAX_ATTEMPTS=3            # Primer escalon
IDENTITY_PIN_LOCKOUT_SECONDS=300       # 5 min
IDENTITY_PIN_LOCKOUT_TIER2_ATTEMPTS=5
IDENTITY_PIN_LOCKOUT_TIER2_SECONDS=900 # 15 min
IDENTITY_PIN_LOCKOUT_TIER3_ATTEMPTS=10
IDENTITY_PIN_LOCKOUT_TIER3_SECONDS=3600  # 60 min
IDENTITY_PIN_LOCKOUT_RESET_HOURS=24    # Sin fallos en 24 h, el contador vuelve a cero

# SOBRE CERRADO DEL PIN DEL QUIOSCO - GENERALO, NO LO COPIES (RF-AT-11, §7.7).
#
# Clave privada X25519 en base64 con la que el servidor abre los PIN que el
# quiosco sella. La publica se DERIVA de esta y se sirve en GET /kiosk/roster,
# asi que aqui solo hay una y no pueden desemparejarse.
#
# Por que existe: el quiosco no puede esperar a tener red para aceptar un
# fichaje. Sellando el PIN al teclearlo, lo que queda en la cola de la tablet es
# un criptograma que solo este servidor abre - ni PIN en claro en IndexedDB, ni
# empleado bloqueado por falta de red.
#
# Generala en el servidor del cliente y no la transmitas. Quien la tenga puede
# leer los PIN que viajen sellados:
#
#   php artisan tinker --execute="echo base64_encode(sodium_crypto_box_secretkey(sodium_crypto_box_keypair()));"
#
# VACIA es un caso legitimo: significa que esta instalacion no ofrece fichaje por
# PIN y el quiosco oculta el teclado numerico (ADR-017).
# [INSTALADOR]
IDENTITY_PIN_SEALING_SECRET_KEY=

# Token de dispositivo del quiosco (RF-ID-04, RS-04, §7.3). 90 dias y rotacion
# automatica al 80 % de vida: renovarlo el ultimo dia dejaria sin fichar a una
# tablet que hubiera pasado una semana desconectada, que es justo lo que la regla
# dura 19 prohibe.
IDENTITY_DEVICE_TOKEN_DAYS=90
IDENTITY_DEVICE_TOKEN_ROTATION_THRESHOLD=0.8

#------------------------------------------------------------------------------
# IMPORTACION MASIVA DE PLANTILLA - RF-GP-05, tarea 5.5
#------------------------------------------------------------------------------
# LO QUE NO ESTA AQUI, Y ES DELIBERADO: el delimitador del CSV y su codificacion.
# Se DETECTAN. Un Excel espanol exporta con ";" y en Windows-1252, y preguntarle
# eso a quien importa es pedirle que acierte a ciegas un detalle que el propio
# fichero dice. El sintoma de fallarlo son los apellidos con la n rota, y nadie
# lo relaciona con un parametro de configuracion.
#
# Lineas de datos como maximo por fichero. El informe de RF-GP-05 es linea a
# linea, asi que se construye entero en memoria: sin tope, el export completo de
# un ERP tumba el proceso con un mensaje que no se parece a su causa.
#
# 500 es el techo documentado de una instalacion (doc 02, Anexo A: hasta 500
# empleados) y ademas el tope que el endpoint puede CUMPLIR: cada alta calcula un
# hash bcrypt de su PIN, unos 160 ms con el coste de produccion, asi que 1000
# altas pasarian del max_execution_time de 60 s. Prometer un tamano que no se
# puede servir es peor que no prometerlo.
#
# Pasarse NO recorta en silencio: el informe lo dice y no aplica nada.
WORKFORCE_IMPORT_MAX_ROWS=500

# Tamano maximo del fichero, en kilobytes. No basta con el limite de Nginx: el
# borde corta en 8 MB y devuelve un 413 SIN CUERPO, que quien lo recibe lee como
# "error de red". Este se comprueba en la aplicacion y produce un 422 que dice
# que hacer. Un XLSX de 500 personas ronda los 60 KB.
WORKFORCE_IMPORT_MAX_FILE_KILOBYTES=4096

# Nombres de columna adicionales, en formato campo=cabecera separado por ";".
# SE SUMAN a los de serie -espanol e ingles-, no los sustituyen: el fichero de la
# semana que viene puede venir del otro sistema. Campos admitidos: first_name,
# last_name, email, national_id, department, hired_at, locale.
# Vacio de serie: la mayoria de los clientes no necesita ninguno (ADR-017).
#WORKFORCE_IMPORT_COLUMN_ALIASES=national_id=documento_id;department=seccion_hotel

# El 2FA obligatorio (RF-ID-01 completo) es de la tarea 2.1 y todavia NO esta
# activo. pragmarx/google2fa esta instalado y sin usar; cuando se active,
# sus variables entraran en este bloque.


#------------------------------------------------------------------------------
# Portal del empleado (doc 02 §7.5, RS-12)
#------------------------------------------------------------------------------
# El bloqueo del PIN NO esta aqui: vive con el resto de la configuracion del PIN,
# arriba, con el prefijo IDENTITY_PIN_. Estuvo duplicado en este bloque con el
# prefijo PIN_ a secas hasta la tarea 1.12 - dos juegos de variables para el mismo
# control, con valores distintos y solo uno leido por la aplicacion. Se unifico en
# el que ya funcionaba.
#
# La restriccion de red de RF-ID-08 (portal accesible desde la red interna por
# defecto) NO es esta variable: es PORTAL_INTERNAL_CIDR, mas abajo, en el bloque
# "Red - PARAMETRO DE INSTALACION". La lee Nginx, no la aplicacion, con el mismo
# mecanismo que KIOSK_VLAN_CIDR y METRICS_ALLOW_CIDR. Vivio aqui como
# PORTAL_INTERNAL_ONLY=true sin que nada la leyera; se retiro para no dejar un
# control fantasma documentado como si existiera.

# Vida de la sesion del portal, en horas. MAS CORTA QUE LA DEL PANEL a proposito
# (§7.3): esto se abre desde un movil personal -con frecuencia prestado o sin
# bloqueo de pantalla- y lo que hay detras son las horas de trabajo de una
# persona. Dos horas sobran para mirar un mes y descargarse el CSV, y no llegan
# para que la sesion siga abierta al dia siguiente.
#
# Restablecer el PIN de alguien invalida sus sesiones abiertas EN EL MOMENTO
# (RF-ID-09), asi que este numero no es lo que responde a un movil perdido: es
# solo el techo de una sesion que nadie cierra.
IDENTITY_PORTAL_SESSION_HOURS=2

# Limite de peticiones del portal (§7.1: 10 r/m). Se aplica por IP Y por codigo
# de empleado a la vez: en un hotel toda la plantilla sale por la misma linea, y
# limitar solo por IP dejaria a un turno entero compartiendo diez intentos por
# minuto. NO sustituye al bloqueo por intentos de arriba: uno frena a quien
# prueba muchos PIN de una persona y el otro a quien prueba un PIN de mucha
# gente (RS-12), y ninguno ve lo que ve el otro.
IDENTITY_PORTAL_RATE_LIMIT=10


#------------------------------------------------------------------------------
# Red - PARAMETRO DE INSTALACION, LEELO ENTERO
#------------------------------------------------------------------------------
# Rango de la VLAN de quioscos. Nginx eleva el limite de fichaje a 600 r/m con
# rafaga de 50 para el trafico que venga de aqui (doc 02 §7.1).
#
# Si colocas los quioscos FUERA de este rango caen al limite general de
# 30 r/m con rafaga de 10, pensado para internet. Todos los quioscos de un
# hotel salen por la misma IP, asi que ese limite frena el fichaje muy por
# debajo de lo que exige RNF-P-06 (50 fichajes/s).
#
# EL FALLO ES SILENCIOSO: no da error, se manifiesta como "el quiosco va lento
# a las 06:00", que es justo el pico de cambio de turno. Si ves ese sintoma,
# esta variable es lo primero que hay que mirar.
#
# El limite interno se ELEVA, no se elimina: RS-02 exige limitar tambien por IP.
# [CLIENTE]
KIOSK_VLAN_CIDR=10.0.20.0/24

# Red desde la que se permite el portal del empleado (RF-ID-08, doc 02 §7.5).
# Fuera de este rango, Nginx devuelve 403 antes de llegar a la aplicacion.
#
# El PIN de 6 digitos del portal es un espacio pequeño (RS-12): restringir el
# portal a la red interna es uno de los cuatro controles que lo compensan
# (bloqueo por intentos, limite por IP, esta restriccion, y que la sesion solo
# alcanza los datos del propio empleado).
#
# EXPONERLO A INTERNET ES UNA DECISION EXPLICITA DEL CLIENTE: se toma poniendo
# aqui 0.0.0.0/0, nunca dejando el valor por defecto. Documentala en el acta de
# entrega si la tomas: es la que responde el dia que alguien pregunte por que el
# portal es alcanzable desde fuera del hotel.
#
# El valor de ejemplo cubre la red de Docker Compose de desarrollo
# (infra/compose.dev.yaml, red "app", 172.28.0.0/16), no una red de produccion:
# cambialo por la LAN real del hotel o la VPN corporativa antes de desplegar.
# [CLIENTE]
PORTAL_INTERNAL_CIDR=172.28.0.0/16

# Limites de la capa de APLICACION para el camino del quiosco, en peticiones por
# minuto (doc 02 §7.1, RS-02). No sustituyen a los de Nginx de arriba: aquellos
# limitan por origen y estos por DISPOSITIVO, que es lo que impide que una tablet
# averiada consuma la cuota de las demas cuando todas salen por la misma IP.
#
# El de IP se conserva porque RS-02 enumera las tres claves —dispositivo,
# credencial e IP— y se fija al mismo valor que la zona interna de Nginx: si fuera
# mas bajo, el techo efectivo lo pondria la aplicacion y el limite del borde no
# mediria nada.
KIOSK_SCAN_RATE_PER_DEVICE=120         # POST /api/v1/scan, por tablet
KIOSK_BATCH_RATE_PER_DEVICE=60         # POST /api/v1/scan/batch (50 escaneos por lote)
KIOSK_TELEMETRY_RATE_PER_DEVICE=60     # Padron y latido
KIOSK_RATE_PER_IP=600                  # Todo el camino del quiosco, por origen
# El fichaje por PIN va dos ordenes de magnitud por debajo, y no es un descuido:
# ahi no se frena un ritmo de fichaje sino fuerza bruta sobre un espacio de 10^6
# (RS-12). Su techo por IP tambien es propio y mas estrecho que el general, porque
# heredar los 600 de arriba lo dejaria sin efecto practico.
KIOSK_PIN_SCAN_RATE_PER_DEVICE=10      # POST /api/v1/scan/pin, por tablet
KIOSK_PIN_SCAN_RATE_PER_IP=60          # POST /api/v1/scan/pin, por origen
KIOSK_BATCH_MAX_SIZE=50                # Tamano maximo del lote (§6). Tambien en el contrato

# Unico origen autorizado a leer /metrics (doc 02 §8.1: restringido a red
# interna). Todo lo demas recibe 403, incluido el propio host.
#
# Por que una /32 y no la red entera: cuando el host pide algo a un puerto
# publicado, Nginx lo ve con la IP de la PASARELA de una de las redes de
# Docker, y cual de ellas depende del orden en que se creo el contenedor. Con
# la red completa autorizada, /metrics quedaria abierto desde el host la mitad
# de las veces, sin avisar. Se autoriza la IP fija de Prometheus y punto.
# [CLIENTE]
METRICS_ALLOW_CIDR=172.29.0.20/32

# Tamano maximo de cuerpo aceptado por Nginx (doc 02 §7.1).
NGINX_CLIENT_MAX_BODY_SIZE=8m

# Certificado TLS. En desarrollo, si no existe, el contenedor genera uno
# autofirmado (por eso curl necesita -k). En produccion se pone el del cliente
# o el de Let's Encrypt y esta variable pasa a false: sin certificado, Nginx no
# arranca y dice que hay que colocarlo. Es intencionado.
# [CLIENTE]
TLS_ALLOW_SELF_SIGNED=true
TLS_CERT_FILE=/etc/nginx/certs/tls.crt
TLS_KEY_FILE=/etc/nginx/certs/tls.key


#------------------------------------------------------------------------------
# Cumplimiento, licencia y marca (ADR-017: la diferencia entre clientes es dato)
#------------------------------------------------------------------------------
# COMPLIANCE_PROFILE es el NOMBRE del perfil de cumplimiento con el que el
# instalador (tarea 5.4) marcara el perfil por defecto de la instalacion. NO se
# lee en ejecucion y no puede leerse: los umbrales legales salen de la fila de
# `compliance_profiles` que resuelve el centro —el asignado, o el de
# `is_default`— y un `.env` que ganara a esa fila dejaria sin efecto lo que el
# cliente guarda en el panel (regla dura 14, decision de la tarea 5.1: manda la
# base de datos). Hoy la migracion siembra `ES-hosteleria` con `is_default`, asi
# que cambiar esto sin cambiar la fila no hace nada.
# [CLIENTE]
COMPLIANCE_PROFILE=ES-hosteleria       # RF-PD-07
#------------------------------------------------------------------------------
# LICENCIA (RF-PD-04, RF-PD-05, ADR-018, tarea 5.3)
#------------------------------------------------------------------------------
#
# LO PRIMERO, PORQUE ES LO QUE MAS SE PREGUNTA: dejar esto vacio NO impide
# fichar. Sin licencia activada se ficha, se consulta el registro, se exporta
# para la Inspeccion, se accede al portal y se hacen copias exactamente igual
# (regla dura 15, ADR-019). Lo unico que no esta disponible son las
# funcionalidades ACCESORIAS: informes por periodo y presencia en tiempo real.
#
# La clave firmada que entrega el fabricante. Formato `KQL1.<carga>.<firma>`.
#
# NO SE LEE EN EJECUCION, y no puede leerse. Lo unico que la mira es
# `php artisan license:activate` cuando se le invoca SIN argumento, que es como
# la llamara el instalador la primera vez. A partir de ahi manda la fila de la
# tabla `license`, igual que manda la fila de `installation_settings` sobre
# `BRANDING_*` (decision de la tarea 5.1: manda la base de datos). Si se leyera
# en ejecucion, una clave activada desde el panel no surtiria efecto mientras
# este fichero dijera otra cosa.
# [CLIENTE]
LICENSE_KEY=
#
# Clave PUBLICA ed25519 del fabricante, en hexadecimal de 64 caracteres.
#
# NO LA TOCA UN CLIENTE. Va compilada en el producto (`config/license.php`) y es
# la misma en todas las instalaciones. Esta variable existe para dos usos y solo
# dos: la suite de pruebas, que genera un par al vuelo, y una rotacion de
# urgencia del par del fabricante sin esperar a una version nueva.
#
# Vacia significa que esta compilacion NO PUEDE VERIFICAR NINGUNA CLAVE, que es
# el estado de un arbol de desarrollo. `php artisan license:show` lo dice con
# esas palabras. La CLAVE PRIVADA no esta aqui ni en ningun sitio del
# repositorio: la custodia el fabricante (§7.7, RS-08).
# LICENSE_PUBLIC_KEY=
#
# Con cuantos dias de antelacion avisa el panel de que la licencia caduca.
# 30 de serie. Durante esos dias NO se degrada nada: la licencia esta vigente y
# el aviso solo dice cuando caduca y como renovar. `0` deja el aviso para el
# ultimo dia, que no es lo recomendable.
# LICENSE_EXPIRY_WARNING_DAYS=30
#
# Cuantos segundos vive la copia del estado de licencia que lee la sonda
# `GET /api/v1/health`.
#
# NO ES UNA CACHE DE LA LICENCIA: el estado que gobierna el producto se
# recalcula siempre desde la clave firmada, asi que una clave recien activada
# surte efecto en el acto. Esto es solo la copia que la sonda de vida puede
# leer SIN TOCAR LA BASE DE DATOS, porque una sonda de vida que consulta
# PostgreSQL hace que Docker reinicie el contenedor de PHP cuando lo caido es
# PostgreSQL. Si expira, la sonda responde `unknown`, que es la verdad; el dato
# autoritativo esta en `license:show` y en `GET /api/v1/license`.
# LICENSE_HEALTH_PROBE_TTL_SECONDS=600
#
TELEMETRY_ENABLED=false                # Desactivada por defecto (RF-PD-12)
ERROR_HISTORY_RETENTION_DAYS=90        # RF-PD-15, igual que el log tecnico (RL-11)
TECHNICAL_LOG_RETENTION_DAYS=90        # RL-11. Almacen distinto del anterior, mismo plazo de serie
# Filas por sentencia de borrado de la purga por retencion (RF-PR-03).
COMPLIANCE_RETENTION_BATCH_SIZE=1000
# Donde queda el informe de cada propuesta y de cada purga. Se queda en el
# servidor del cliente y NO se limpia solo: es la constancia de que la purga fue
# regular (ADR-020). Por defecto storage/app/retention-reports.
# COMPLIANCE_RETENTION_REPORT_PATH=
#
# LOS ANOS DE RETENCION DEL REGISTRO HORARIO NO ESTAN AQUI (regla dura 14): son
# un umbral legal y salen del perfil de cumplimiento del centro
# (compliance_profiles.retention_years, 4 anos en el perfil ES-hosteleria).
# Horas que un temporal HUERFANO de storage/framework/legal-exports/ puede vivir
# antes de que `compliance:purge-legal-export-temp` lo borre. Es la descarga
# HTTP de la exportacion legal (RF-IN-05) cuando el cliente aborta a medias y
# `deleteFileAfterSend()` nunca corre. NO afecta a storage/app/legal-exports/,
# la copia deliberada de `compliance:legal-export` para Inspeccion: esa la
# custodia y borra quien la genero (docs/runbooks/requerimiento-inspeccion.md).
COMPLIANCE_LEGAL_EXPORT_TEMP_RETENTION_HOURS=6

# Ventana, en segundos, en la que las denegaciones por ambito repetidas de un
# mismo actor y conjunto de datos se agrupan en un unico asiento `access.denied`
# de audit_log (el siguiente asiento lleva el recuento). Protege el candado
# unico de la auditoria (ADR-010, ADR-037) de una enumeracion de UUID ajenos.
# 0 = sin agrupar, un asiento por denegacion.
COMPLIANCE_AUTHZ_DENIAL_WINDOW_SECONDS=60

# Dias hacia atras que revisa `attendance:detect-incidents` (RF-PR-01). La
# deteccion NO reprocesa el historico: abrir incidencias sobre jornadas ya
# entregadas a la plantilla o a la Inspeccion no ayuda a nadie (doc 01 §4).
# Los tramos TODAVIA ABIERTOS se revisan siempre, sea cual sea su fecha.
COMPLIANCE_INCIDENT_LOOKBACK_DAYS=7


#------------------------------------------------------------------------------
# Observabilidad (doc 02 §8.1)
#------------------------------------------------------------------------------
# Log tecnico en JSON hacia stderr, que es lo que recoge Loki. Regla dura 21:
# jamas nombres de empleados. El contexto es trace_id, scan_id, device_id y
# employee_uuid, y lo inyecta el processor de Monolog (tarea 0.2).
LOG_CHANNEL=stderr
LOG_LEVEL=debug                        # info o warning en produccion
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOKI_URL=http://loki:3100
# §8.1. Vacio desactiva la exportacion de trazas
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=kronoqr-api

GRAFANA_ADMIN_USER=admin
# [INSTALADOR]
GRAFANA_ADMIN_PASSWORD=kronoqr_local_dev_only   # SOLO DESARROLLO. Grafana nunca se expone sin autenticacion


#------------------------------------------------------------------------------
# Correo (en desarrollo, Mailpit; en produccion, el SMTP del cliente)
#
# POR ESTE CANAL SALEN NOMBRES DE LA PLANTILLA, A DIARIO. El resumen de
# incidencias de RF-PR-01 se envia cada noche al responsable de cada
# departamento con la fecha, el nombre y el tipo de cada hallazgo. Es el UNICO
# camino por el que datos personales salen del servidor del cliente sin que
# nadie pulse nada, y por eso deja asiento en audit_log
# (`personal_data.accessed`, dataset `incident_digest`). Si el relevo SMTP es de
# un tercero, ese tercero es un ENCARGADO DEL TRATAMIENTO (art. 28 RGPD) y el
# cliente tiene que tenerlo contratado: docs/cliente/obligaciones-legales.md §2.
#------------------------------------------------------------------------------
# [CLIENTE]
MAIL_MAILER=smtp
# [CLIENTE]
MAIL_HOST=mailpit
# [CLIENTE]
MAIL_PORT=1025
# [CLIENTE]
MAIL_USERNAME=
# [CLIENTE]
MAIL_PASSWORD=
# Cifrado del transporte. Laravel 13 lee MAIL_SCHEME, no MAIL_ENCRYPTION:
# escribir la clave antigua no configura nada y deja creer que si.
#
#   (vacio)  Deja que Symfony Mailer elija: STARTTLS OPORTUNISTA. Si el relevo
#            no anuncia STARTTLS, la sesion sigue EN CLARO y el correo -con
#            nombres dentro- viaja legible. Vale para Mailpit en desarrollo.
#   smtp     Lo mismo, explicito. Misma degradacion silenciosa.
#   smtps    TLS IMPLICITO desde el primer byte (puerto 465 tipicamente). Si el
#            relevo no lo soporta, el envio FALLA en vez de degradarse: es lo
#            que hay que poner en produccion.
#
# Un fallo de envio no rompe nada del registro: la incidencia sigue abierta en
# la bandeja y entra en el resumen de la noche siguiente.
MAIL_SCHEME=
# [CLIENTE]
MAIL_FROM_ADDRESS=no-reply@kronoqr.local
MAIL_FROM_NAME=KronoQR


#------------------------------------------------------------------------------
# Copias de seguridad (RF-PR-04, RNF-D-02: RPO 15 min, RTO 4 h)
#
# La copia se queda en la infraestructura del cliente: el fabricante no la
# recibe ni la custodia (regla dura 16, RL-14). Si BACKUP_PATH apunta a un
# recurso de red, tiene que estar montado ANTES de levantar los servicios.
# Detalle de operacion en docs/runbooks/restaurar-backup.md.
#------------------------------------------------------------------------------
# Destino de las copias. Se monta en la misma ruta dentro de los contenedores.
# [CLIENTE]
BACKUP_PATH=/var/backups/fichaje
# Separada de la clave de base de datos. La genera install.sh.
# SIN ELLA NO HAY COPIA: el script se niega a empezar (RL-12). Y sin ella
# tampoco se puede restaurar una copia anterior: custodiala fuera del servidor.
# [INSTALADOR]
BACKUP_ENCRYPTION_KEY=
# Dias que se conservan las copias diarias.
BACKUP_RETENTION_DAYS=30
# Copias que nunca se borran, aunque hayan caducado todas.
BACKUP_MIN_COPIES=3
# Dias de WAL archivado que se conservan. DEBE ser mayor que el intervalo entre
# copias fisicas (semanal por defecto): sin la copia fisica anterior, el WAL
# archivado no reconstruye nada.
BACKUP_WAL_RETENTION_DAYS=8
# Cuando se lanzan, en UTC (regla dura 3). Nunca cerca del cambio de turno.
BACKUP_DAILY_AT=03:15
BACKUP_WEEKLY_AT=02:15
BACKUP_WEEKLY_ON=0                     # 0 = domingo


#------------------------------------------------------------------------------
# Solo produccion (compose.prod.yaml). En desarrollo se ignoran.
#------------------------------------------------------------------------------
# [CLIENTE]
IMAGE_REGISTRY=ghcr.io/kronoqr        # Registro de donde se descargan las imagenes

# Version desplegada: la etiqueta de las imagenes que se descargan y lo que
# publica GET /api/v1/health.
#
# VA VACIA Y LA RELLENA install.sh con el contenido del fichero VERSION del
# paquete de entrega. `latest` esta PROHIBIDO en produccion (doc 02 §11.6.1) y
# compose.prod.yaml no tiene valor por defecto: si esta variable esta vacia,
# Compose se para antes de crear nada y dice que poner. Una instalacion que no
# sabe decir que version corre obliga a entrar por SSH para diagnosticar
# cualquier incidencia, y hace imposible la vuelta atras de update.sh.
# [INSTALADOR]
IMAGE_TAG=

# Servicios de observabilidad (Prometheus, node-exporter, Alertmanager, Grafana
# y Loki). ENCENDIDOS de serie, y conviene dejarlos: son los que avisan de que
# la copia de anoche fallo o de que el archivado de WAL se ha parado, que son
# los dos fallos que convierten una instalacion sana en una perdida de datos
# sin que nadie lo note mirando la pantalla.
#
# Dejarlo VACIO los apaga. Es una configuracion soportada —libera unos 700 MiB
# en un servidor justo en el minimo de 4 GB— y lo que se pierde exactamente
# esta en docs/cliente/operacion.md. Sin ellos, verificar la copia pasa a ser
# una tarea manual semanal del IT del hotel.
COMPOSE_PROFILES=observability

# [CLIENTE]
HTTP_PORT=80
# [CLIENTE]
HTTPS_PORT=443
# [CLIENTE]
TLS_CERT_DIR=./certs                   # Directorio del host con tls.crt y tls.key
