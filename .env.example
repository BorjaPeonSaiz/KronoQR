#==============================================================================
# KronoQR - plantilla de configuracion
#==============================================================================
# Copia este fichero a .env (make up lo hace solo la primera vez) y rellena lo
# que corresponda. Este fichero se versiona; .env NO se versiona nunca.
#
# Regla que gobierna todo lo de abajo (doc 02 §7.7): NADA DE SECRETOS EN EL
# REPOSITORIO. En desarrollo, los valores marcados como "solo desarrollo" son
# placeholders sin valor fuera de tu maquina. En produccion, install.sh genera
# los secretos EN EL SERVIDOR DEL CLIENTE y no los transmite a nadie.
#
# Como generar un valor aleatorio de 32 bytes en base64:
#   openssl rand -base64 32
#
# UNA VARIABLE VACIA NO LLEVA COMENTARIO EN SU MISMA LINEA. Docker Compose
# recorta el comentario cuando la variable tiene valor, pero cuando esta vacia
# le asigna el comentario COMO VALOR: REDIS_PASSWORD acababa valiendo
# "# Vacio en desarrollo...", y el fallo aparece lejos de aqui, como un error
# de autenticacion de Redis. El comentario va en la linea de encima.
#==============================================================================


#------------------------------------------------------------------------------
# Aplicacion
#------------------------------------------------------------------------------
APP_NAME=KronoQR
APP_ENV=local                          # local en desarrollo, production en cliente
APP_DEBUG=true                         # false SIEMPRE en produccion
# Clave de cifrado de la aplicacion. Generala y pegala aqui:
#   docker compose --env-file .env -f infra/compose.dev.yaml exec -T app \
#     php artisan key:generate --show
# Con --show a proposito: la aplicacion lee su configuracion del entorno del
# contenedor, no de un backend/.env, asi que artisan no tiene fichero que
# reescribir. En produccion la genera install.sh en el servidor del cliente.
APP_KEY=
APP_URL=https://localhost

# Regla dura 3: TODO instante se almacena en UTC. La zona horaria de
# presentacion es un atributo de cada centro (sites.timezone), nunca del
# proceso. Cambiar esto invalida el calculo de jornada (RN-04, RN-05, ADR-004).
APP_TIMEZONE=UTC

# Idioma de los documentos que genera el SERVIDOR: hoy la exportacion legal
# para Inspeccion (tarea 1.17), manana los informes sellados. No es el idioma
# del panel —ese lo elige cada persona en su navegador—, es el de un fichero
# que se entrega a un tercero, y por eso es configuracion de la instalacion y
# no una constante (regla dura 13, ADR-017). Traducciones disponibles: es, en.
APP_LOCALE=es
APP_FALLBACK_LOCALE=es


#------------------------------------------------------------------------------
# Base de datos - PostgreSQL 17
#------------------------------------------------------------------------------
#
# TRES ROLES, Y NO ES BUROCRACIA (tarea 1.14, regla dura 6, ADR-027).
#
# Un GRANT o un REVOKE sobre un SUPERUSUARIO de PostgreSQL es decorativo: el
# motor ni los comprueba. Mientras la aplicacion corrio con el rol de arranque
# del cluster, "el usuario de aplicacion no tiene UPDATE ni DELETE sobre
# audit_log" era una frase en un documento. Ahora son tres roles distintos:
#
#   fichaje_migrator     Propietario y unico con DDL. Ejecuta las MIGRACIONES.
#   fichaje_app          Runtime. Sin DDL. Sobre audit_log, solo INSERT+SELECT.
#   fichaje_maintenance  Retencion (tarea 2.10). Unico que suelta particiones.
#                        SIN CONTRASEÑA AQUI, a proposito: no es un rol de la
#                        aplicacion y su credencial no vive en este fichero.
#
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fichaje
DB_USERNAME=fichaje_app                # Sin DDL. Sin UPDATE/DELETE sobre audit_log (regla dura 6)
DB_PASSWORD=kronoqr_local_dev_only     # SOLO DESARROLLO. En produccion lo genera install.sh

# Rol de migracion. Es POSTGRES_USER del contenedor y el propietario de todo.
# `php artisan migrate` corre sobre la conexion `pgsql_migrator`, que usa estas
# credenciales; la aplicacion en marcha no las toca nunca.
#
# En produccion se pueden dejar FUERA del entorno de los contenedores y pasarse
# solo al desplegar, que es cuando hacen falta:
#   docker compose run --rm -e DB_MIGRATION_PASSWORD=... app php artisan migrate --database=pgsql_migrator --force
DB_MIGRATION_USERNAME=fichaje_migrator
DB_MIGRATION_PASSWORD=kronoqr_local_dev_only_migrator   # SOLO DESARROLLO

# Rol de mantenimiento (ADR-027). Se declara el nombre para que el script de
# roles lo cree; la contraseña NO va aqui.
DB_MAINTENANCE_USERNAME=fichaje_maintenance

# Usuario con el que se hacen las COPIAS. Es el de migracion y no el de la
# aplicacion por dos razones concretas: `pg_basebackup` exige el atributo
# REPLICATION y restaurar exige CREATEDB, y fichaje_app no tiene ninguno de los
# dos desde la tarea 1.14. Sin esto, la copia fisica que sostiene el RPO de 15
# minutos (RNF-D-02) fallaria en la primera ejecucion.
BACKUP_DB_USERNAME=fichaje_migrator
BACKUP_DB_PASSWORD=kronoqr_local_dev_only_migrator      # SOLO DESARROLLO


#------------------------------------------------------------------------------
# Redis 7 - colas, cache, rate limiting, sesiones
#------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# Vacio en desarrollo (Redis no publica puerto al exterior)
REDIS_PASSWORD=
QUEUE_CONNECTION=redis                 # Fallback a driver de base de datos si Redis cae (RNF-D-03)
CACHE_STORE=redis
SESSION_DRIVER=redis


#------------------------------------------------------------------------------
# WebSocket de presencia en vivo - Laravel Reverb
#------------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
# Se genera en la instalacion
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http


#------------------------------------------------------------------------------
# Credencial QR (doc 02 §5)
#------------------------------------------------------------------------------
QR_SIGNING_KEY_CURRENT_ID=a3           # Clave activa. Dos caracteres (§5.1)
# 32 bytes en base64. Se genera en el servidor
QR_SIGNING_KEY_CURRENT=
QR_SIGNING_KEY_PREVIOUS_ID=a2          # Solape durante la rotacion (§5.3, RF-QR-07)
QR_SIGNING_KEY_PREVIOUS=
QR_ERROR_CORRECTION=Q                  # Tolerancia al desgaste de la tarjeta (RF-QR-05)
QR_SIZE_MM=26                          # Lado del QR impreso. Tamano minimo garantizado (RF-QR-05)

# Marca de la instalacion en la tarjeta impresa (RF-PD-08, regla dura 13). Los
# tres son opcionales y ninguno trae una marca de serie: una tarjeta sin
# logotipo se imprime igual. La tarea 5.8 los traslada a la configuracion del
# panel; hasta entonces se declaran aqui.
# BRANDING_NAME=                       # Vacio = se imprime el nombre del centro
# BRANDING_LOGO_PATH=                  # Ruta ABSOLUTA en el servidor a un PNG o SVG
BRANDING_ACCENT_COLOR=#111827

# Browsershot, que es lo que dibuja el PDF de las tarjetas (spatie/laravel-pdf,
# doc 02 §3.1). Las rutas son las de la imagen del producto: Chromium y Puppeteer
# vienen DENTRO (infra/docker/php/Dockerfile), no se descargan al arrancar.
#
# --no-sandbox porque el contenedor ya corre como usuario sin privilegios y sin
# capacidades adicionales: el sandbox de Chromium necesita user namespaces que el
# contenedor no concede, y el HTML que se le entrega no viene de fuera -lo genera
# la propia aplicacion, sin ninguna URL remota-.
LARAVEL_PDF_CHROME_PATH=/usr/bin/chromium-browser
LARAVEL_PDF_NODE_MODULES_PATH=/usr/local/lib/node_modules
LARAVEL_PDF_NO_SANDBOX=true

# Suelo de tiempo que consume TODO rechazo de credencial (RS-03, regla dura 17).
# Los cuatro rechazos -formato, clave, firma y credencial desconocida o
# revocada- recorren pasos distintos, y sin suelo la diferencia de microsegundos
# entre "no hay fila" y "hay fila revocada" se mide desde fuera. Subirlo endurece
# el control y anade latencia SOLO al rechazo; bajarlo a 0 lo desactiva y no
# deberia hacerse en produccion.
IDENTITY_CREDENTIAL_REJECTION_FLOOR_MS=25


#------------------------------------------------------------------------------
# Reglas de fichaje - umbrales configurables, nunca constantes en el codigo
#------------------------------------------------------------------------------
ATTENDANCE_DEBOUNCE_SECONDS=60         # RF-AT-06
ATTENDANCE_MAX_SHIFT_HOURS=12          # RN-08
ATTENDANCE_MAX_CLOCK_SKEW_MINUTES=15   # RF-AT-10. Genera incidencia, NUNCA rechaza el fichaje
ATTENDANCE_PATTERN_WINDOW_SECONDS=10   # RF-PR-06. Fichajes consecutivos en el mismo quiosco
ATTENDANCE_PATTERN_MIN_REPEATS=3       # RF-PR-06. Coincidencias antes de generar incidencia
ATTENDANCE_MIN_TRANSIT_SECONDS=120     # RN-16. Transito minimo entre dos quioscos distintos


#------------------------------------------------------------------------------
# Acceso al panel de gestion (RF-ID-01, doc 02 §7.3)
#------------------------------------------------------------------------------
# Bloqueo por intentos fallidos. NO es el rate limiting del §7.1: aquel cuenta
# peticiones por origen y lo aplican Nginx y la ruta; esto cuenta FALLOS por
# cuenta, que es lo que frena a quien prueba contrasenas contra un correo
# conocido desde muchas IP.
IDENTITY_LOGIN_MAX_ATTEMPTS=5
IDENTITY_LOGIN_LOCKOUT_SECONDS=900     # 15 min

# Vida del token del panel. Corta a proposito (§7.3). El token del quiosco dura
# 90 dias y no se ve afectado: la caducidad se fija token a token.
IDENTITY_SESSION_TOKEN_HOURS=12

# Longitud minima de la contrasena de gestion. La politica completa -mayusculas,
# minusculas, digitos y simbolos- se aplica al fijarla, en identity:create-user.
IDENTITY_PASSWORD_MIN_LENGTH=12

# PIN del empleado (RF-ID-09). Seis digitos: la longitud NO es configurable
# porque el contrato la fija. Lo que si lo es son los PIN que el generador nunca
# emite -de serie, los repetidos y las secuencias- y el bloqueo por intentos, que
# es el de RS-12 y no el del panel: quien teclea mal en un quiosco a las 06:00 no
# es quien prueba contrasenas contra el panel. Restablecer el PIN limpia ese
# contador: quien pide uno nuevo tiene que poder usarlo en el momento.
# IDENTITY_PIN_FORBIDDEN se declara separado por comas y sustituye a la lista de
# serie completa; vacio significa "no excluir ninguno", que es una mala idea.
#IDENTITY_PIN_FORBIDDEN=000000,111111,123456
IDENTITY_PIN_MAX_ATTEMPTS=5
IDENTITY_PIN_LOCKOUT_SECONDS=900       # 15 min

# Token de dispositivo del quiosco (RF-ID-04, RS-04, §7.3). 90 dias y rotacion
# automatica al 80 % de vida: renovarlo el ultimo dia dejaria sin fichar a una
# tablet que hubiera pasado una semana desconectada, que es justo lo que la regla
# dura 19 prohibe.
IDENTITY_DEVICE_TOKEN_DAYS=90
IDENTITY_DEVICE_TOKEN_ROTATION_THRESHOLD=0.8

# El 2FA obligatorio (RF-ID-01 completo) es de la tarea 2.1 y todavia NO esta
# activo. pragmarx/google2fa esta instalado y sin usar; cuando se active,
# sus variables entraran en este bloque.


#------------------------------------------------------------------------------
# PIN de respaldo y portal del empleado (doc 02 §7.5, RS-12)
#------------------------------------------------------------------------------
PIN_MAX_ATTEMPTS=3                     # Primer escalon de bloqueo
PIN_LOCKOUT_SECONDS=300                # 5 min
PIN_LOCKOUT_TIER2_ATTEMPTS=5
PIN_LOCKOUT_TIER2_SECONDS=900          # 15 min
PIN_LOCKOUT_TIER3_ATTEMPTS=10
PIN_LOCKOUT_TIER3_SECONDS=3600         # 60 min
PIN_LOCKOUT_RESET_HOURS=24             # El contador se reinicia sin fallos en 24 h
PORTAL_INTERNAL_ONLY=true              # RF-ID-08. Exponer el portal exige decision explicita


#------------------------------------------------------------------------------
# Red - PARAMETRO DE INSTALACION, LEELO ENTERO
#------------------------------------------------------------------------------
# Rango de la VLAN de quioscos. Nginx eleva el limite de fichaje a 600 r/m con
# rafaga de 50 para el trafico que venga de aqui (doc 02 §7.1).
#
# Si colocas los quioscos FUERA de este rango caen al limite general de
# 30 r/m con rafaga de 10, pensado para internet. Todos los quioscos de un
# hotel salen por la misma IP, asi que ese limite frena el fichaje muy por
# debajo de lo que exige RNF-P-06 (50 fichajes/s).
#
# EL FALLO ES SILENCIOSO: no da error, se manifiesta como "el quiosco va lento
# a las 06:00", que es justo el pico de cambio de turno. Si ves ese sintoma,
# esta variable es lo primero que hay que mirar.
#
# El limite interno se ELEVA, no se elimina: RS-02 exige limitar tambien por IP.
KIOSK_VLAN_CIDR=10.0.20.0/24

# Limites de la capa de APLICACION para el camino del quiosco, en peticiones por
# minuto (doc 02 §7.1, RS-02). No sustituyen a los de Nginx de arriba: aquellos
# limitan por origen y estos por DISPOSITIVO, que es lo que impide que una tablet
# averiada consuma la cuota de las demas cuando todas salen por la misma IP.
#
# El de IP se conserva porque RS-02 enumera las tres claves —dispositivo,
# credencial e IP— y se fija al mismo valor que la zona interna de Nginx: si fuera
# mas bajo, el techo efectivo lo pondria la aplicacion y el limite del borde no
# mediria nada.
KIOSK_SCAN_RATE_PER_DEVICE=120         # POST /api/v1/scan, por tablet
KIOSK_BATCH_RATE_PER_DEVICE=60         # POST /api/v1/scan/batch (50 escaneos por lote)
KIOSK_TELEMETRY_RATE_PER_DEVICE=60     # Padron y latido
KIOSK_RATE_PER_IP=600                  # Todo el camino del quiosco, por origen
KIOSK_BATCH_MAX_SIZE=50                # Tamano maximo del lote (§6). Tambien en el contrato

# Unico origen autorizado a leer /metrics (doc 02 §8.1: restringido a red
# interna). Todo lo demas recibe 403, incluido el propio host.
#
# Por que una /32 y no la red entera: cuando el host pide algo a un puerto
# publicado, Nginx lo ve con la IP de la PASARELA de una de las redes de
# Docker, y cual de ellas depende del orden en que se creo el contenedor. Con
# la red completa autorizada, /metrics quedaria abierto desde el host la mitad
# de las veces, sin avisar. Se autoriza la IP fija de Prometheus y punto.
METRICS_ALLOW_CIDR=172.29.0.20/32

# Tamano maximo de cuerpo aceptado por Nginx (doc 02 §7.1).
NGINX_CLIENT_MAX_BODY_SIZE=8m

# Certificado TLS. En desarrollo, si no existe, el contenedor genera uno
# autofirmado (por eso curl necesita -k). En produccion se pone el del cliente
# o el de Let's Encrypt y esta variable pasa a false: sin certificado, Nginx no
# arranca y dice que hay que colocarlo. Es intencionado.
TLS_ALLOW_SELF_SIGNED=true
TLS_CERT_FILE=/etc/nginx/certs/tls.crt
TLS_KEY_FILE=/etc/nginx/certs/tls.key


#------------------------------------------------------------------------------
# Cumplimiento, licencia y marca (ADR-017: la diferencia entre clientes es dato)
#------------------------------------------------------------------------------
COMPLIANCE_PROFILE=ES-hosteleria       # RF-PD-07
# Clave firmada, verificacion local (ADR-018)
LICENSE_KEY=
TELEMETRY_ENABLED=false                # Desactivada por defecto (RF-PD-12)
ERROR_HISTORY_RETENTION_DAYS=90        # RF-PD-15, igual que el log tecnico (RL-11)
# RF-PD-08. Vacio = se usa APP_NAME
BRANDING_APP_NAME=
# RF-PD-08
BRANDING_LOGO_PATH=


#------------------------------------------------------------------------------
# Observabilidad (doc 02 §8.1)
#------------------------------------------------------------------------------
# Log tecnico en JSON hacia stderr, que es lo que recoge Loki. Regla dura 21:
# jamas nombres de empleados. El contexto es trace_id, scan_id, device_id y
# employee_uuid, y lo inyecta el processor de Monolog (tarea 0.2).
LOG_CHANNEL=stderr
LOG_LEVEL=debug                        # info o warning en produccion
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOKI_URL=http://loki:3100
# §8.1. Vacio desactiva la exportacion de trazas
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=kronoqr-api

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=kronoqr_local_dev_only   # SOLO DESARROLLO. Grafana nunca se expone sin autenticacion


#------------------------------------------------------------------------------
# Correo (en desarrollo, Mailpit; en produccion, el SMTP del cliente)
#------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@kronoqr.local
MAIL_FROM_NAME=KronoQR


#------------------------------------------------------------------------------
# Copias de seguridad (RF-PR-04, RNF-D-02: RPO 15 min, RTO 4 h)
#
# La copia se queda en la infraestructura del cliente: el fabricante no la
# recibe ni la custodia (regla dura 16, RL-14). Si BACKUP_PATH apunta a un
# recurso de red, tiene que estar montado ANTES de levantar los servicios.
# Detalle de operacion en docs/runbooks/restaurar-backup.md.
#------------------------------------------------------------------------------
# Destino de las copias. Se monta en la misma ruta dentro de los contenedores.
BACKUP_PATH=/var/backups/fichaje
# Separada de la clave de base de datos. La genera install.sh.
# SIN ELLA NO HAY COPIA: el script se niega a empezar (RL-12). Y sin ella
# tampoco se puede restaurar una copia anterior: custodiala fuera del servidor.
BACKUP_ENCRYPTION_KEY=
# Dias que se conservan las copias diarias.
BACKUP_RETENTION_DAYS=30
# Copias que nunca se borran, aunque hayan caducado todas.
BACKUP_MIN_COPIES=3
# Dias de WAL archivado que se conservan. DEBE ser mayor que el intervalo entre
# copias fisicas (semanal por defecto): sin la copia fisica anterior, el WAL
# archivado no reconstruye nada.
BACKUP_WAL_RETENTION_DAYS=8
# Cuando se lanzan, en UTC (regla dura 3). Nunca cerca del cambio de turno.
BACKUP_DAILY_AT=03:15
BACKUP_WEEKLY_AT=02:15
BACKUP_WEEKLY_ON=0                     # 0 = domingo


#------------------------------------------------------------------------------
# Solo produccion (compose.prod.yaml). En desarrollo se ignoran.
#------------------------------------------------------------------------------
IMAGE_REGISTRY=ghcr.io/kronoqr        # Registro de donde se descargan las imagenes
IMAGE_TAG=latest                       # Version desplegada, visible en /api/v1/health
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=./certs                   # Directorio del host con tls.crt y tls.key
