      "description": "incidents_open{type=\"open_shift_expired\"}. Umbral de la alerta homónima: cualquiera, media, RRHH (docs/runbooks/turno-abierto-prolongado.md).",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 14 },
