# KronoQR — configuracion base de Prometheus (doc 02 §8.1).
#
# El catalogo completo de alertas del doc 01 §9.3 (tarea 3.2) vive en rules/:
# varios ficheros, uno por componente, con cabecera propia que cita la fila
# del catalogo que implementa.
#
# PLANTILLA, NO CONFIGURACION DIRECTA (tarea 3.8, hallazgo H-05). Prometheus,
# a diferencia de Alertmanager, no necesita casi ninguna variable de
# instalacion — salvo una: `APP_URL`, el dominio publico por el que los
# clientes reales llegan al hotel, que hace falta para la sonda TLS que SI
# verifica identidad (`http_2xx_tls_verified`, `blackbox/blackbox.yml`).
# `APP_URL` es especifico de cada cliente (regla dura 13: nada de eso vive en
# el repositorio del fabricante), asi que este fichero es una PLANTILLA con
# una unica marca, `@@KRONOQR_UPTIME_TLS_VERIFIED_JOB@@`, que
# `render-config.sh` (mismo mecanismo que `infra/observability/alertmanager/`,
# ver su cabecera para el porque de un script y no un `sed`) resuelve contra
# el entorno del contenedor ANTES de que el binario arranque, y escribe el
# resultado en `/prometheus/prometheus.yml` — el volumen de datos, de lectura
# y escritura, nunca este `.template`, que viaja de solo lectura. El resto del
# fichero (scrape_configs, alerting, rule_files) es identico linea a linea a
# lo que habia antes de la tarea 3.8: NINGUNA otra parte de Prometheus
# necesita renderizado.

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  # SIN etiqueta de instalacion (decision 8 de la tarea 3.2). ADR-016 fija una
  # instalacion por cliente y los destinatarios de cada alerta son los de ESE
  # cliente (el fabricante no recibe ninguna, ADR-020): una etiqueta que nadie
  # consume a cambio de una feature flag y una variable mas no aporta nada. Si
  # un grupo con varios hoteles quisiera un Alertmanager comun, es una decision
  # de esa instalacion y se documenta como limite en docs/cliente/operacion.md.

rule_files:
  - /etc/prometheus/rules/*.yml

# Alertmanager, ya conectado: desde la tarea 1.18 hay reglas que encaminar.
# Desde la tarea 3.2 tambien existe en desarrollo (compose.dev.yaml, mismo
# entrypoint de renderizado que produccion): los dos entornos evaluan la
# ruta y la inhibicion contra el MISMO Alertmanager, no solo contra las
# reglas de Prometheus.
alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]

  # Metricas de la aplicacion (§8.2). Se leen a traves del borde, que restringe
  # /metrics a METRICS_ALLOW_CIDR: Prometheus es el unico origen autorizado.
  #
  # En la Fase 0 este objetivo aparece DOWN y es correcto: la aplicacion
  # Laravel que expone /metrics llega en la tarea 0.2 y la instrumentacion, en
  # la 3.1.
  - job_name: kronoqr-api
    metrics_path: /metrics
    scheme: http
    static_configs:
      - targets: ["nginx:8080"]
        labels:
          service: api

  # node-exporter: resultado de la copia de seguridad, de su verificacion y del
  # simulacro de restauracion (tarea 1.18), la ventana de mantenimiento del
  # actualizador (tarea 3.2, kronoqr_maintenance.prom), el espacio en disco del
  # servidor (tarea 3.2, host.yml) y, desde la tarea 2.4, open_shifts_current y
  # websocket_connections_active (§8.2) por el mismo colector textfile.
  #
  # RENOMBRADO EN LA TAREA 3.2 (decision 7): el job se llamaba `kronoqr-backup`
  # desde la Fase 1, cuando de verdad solo servia el resultado de la copia.
  # Desde la tarea 2.4 ya servia mucho mas y el nombre mentia; ahora que este
  # mismo job es tambien el origen de `node_filesystem_*` para la alerta de
  # disco y de `kronoqr_maintenance_*` para la inhibicion, mentir un escalon
  # mas habria sido peor. Ninguna regla de alerta casa por la etiqueta
  # `service`, todas casan por nombre de metrica, asi que el cambio es solo de
  # nombre visible en Prometheus y Grafana. `BackupAndAlertingTest` deja de
  # afirmar el nombre antiguo.
  #
  # La mayoria de estas metricas cambian una vez al dia o una vez por
  # mantenimiento; se recogen cada minuto y no cada 15 segundos para no
  # engordar la base de metricas con ficheros que apenas cambian.
  - job_name: kronoqr-node
    scrape_interval: 60s
    static_configs:
      - targets: ["node-exporter:9100"]
        labels:
          service: node

  # Sonda de uptime (tarea 3.1, §8.1): comprueba desde FUERA del proceso que
  # el borde responde, en vez de confiar solo en que /metrics siga sirviendo
  # series. blackbox-exporter hace la peticion real por nosotros y publica
  # `probe_success` y `probe_duration_seconds`.
  #
  # POR TLS, CONTRA EL PUERTO 8443, NUNCA POR EL 8080. El 8080 lo publica el
  # host como HTTP_PORT (compose.prod.yaml) y no lleva `limit_req`: sondear
  # ahi habria dejado /api/v1/health y /api/v1/ready alcanzables sin cuota
  # desde cualquiera que llegue al puerto 80, justo lo que las reglas duras 15
  # y 19 prohiben. Sondeando por 8443 la peticion entra por `location ^~
  # /api/` del bloque 443 de kronoqr.conf.template y pasa por
  # `limit_req zone=api`, igual que cualquier otro cliente HTTPS.
  #
  # `insecure_skip_verify: true` (modulo `http_2xx_tls` de blackbox.yml) es
  # aceptable aqui: la peticion viaja dentro de la red de contenedores, el
  # certificado que sirve `nginx` es el del dominio del hotel (no el de
  # `nginx`), y lo que esta sonda comprueba es DISPONIBILIDAD (¿responde
  # 200?), no identidad del servidor.
  #
  # Relabelling estandar de blackbox: el objetivo de verdad (la URL a sondear)
  # va como parametro `target` de /probe, y el nombre visible en Grafana
  # (`instance`) pasa a ser esa URL y no la IP del propio blackbox-exporter.
  #
  # ES EL MISMO EXPORTADOR QUE USA LA ALERTA «certificado TLS proximo a
  # expirar» de la tarea 3.2 (`probe_ssl_earliest_cert_expiry`, `rules/
  # tls.yml`, modulo `http_2xx_tls` de blackbox/blackbox.yml): al sondear ya
  # por HTTPS, esa metrica sale gratis de esta misma peticion — no hizo falta
  # levantar un segundo contenedor ni anadir una sonda para esa alerta.
  # Alertmanager, vigilado (decision 17c de la tarea 3.2). Hasta ahora nadie
  # scrapeaba a Alertmanager: sin este job, `up{job="alertmanager"}` no existe
  # y `EnrutadoDeAlertasCaido` (rules/alerting.yml) no tiene nada que evaluar.
  # Con la copia fallando Y la cadena de auditoria rota A LA VEZ que
  # Alertmanager, nadie se habria enterado de ninguna de las tres. El propio
  # binario expone /metrics en su puerto HTTP, incluida
  # `alertmanager_notifications_failed_total`, que es la otra mitad de
  # `alerting.yml` (`EntregaDeAlertasFallando`).
  - job_name: alertmanager
    static_configs:
      - targets: ["alertmanager:9093"]
        labels:
          service: alerting

  - job_name: kronoqr-uptime
    metrics_path: /probe
    params:
      module: [http_2xx_tls]
    scrape_interval: 30s
    static_configs:
      - targets:
          - https://nginx:8443/api/v1/health
          - https://nginx:8443/api/v1/ready
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115

  # SEGUNDA SONDA DE TLS, LA QUE SI VERIFICA IDENTIDAD (tarea 3.8, H-05).
  # `kronoqr-uptime` de arriba entra por la red de contenedores contra
  # `nginx:8443`, con `insecure_skip_verify: true` a proposito: nunca podria
  # comprobar la cadena o el nombre sin dar SIEMPRE un falso negativo. Este
  # job hace lo que el otro no puede: llega por `APP_URL`, el dominio publico
  # real, y con `http_2xx_tls_verified` (`insecure_skip_verify: false`)
  # exige cadena completa, emisor de confianza y nombre coincidente — la
  # alerta `CertificadoTlsNoVerificable` (rules/tls.yml) vive de esta serie.
  #
  # LA LINEA SIGUIENTE ES LA MARCA QUE RENDERIZA `render-config.sh`, NO YAML
  # VALIDO POR SI SOLA. Se sustituye por el bloque `- job_name: ...` completo
  # cuando `APP_URL` esta configurada y la instalacion NO declaro
  # `TLS_ALLOW_SELF_SIGNED=true`, o por un comentario vacio en caso contrario
  # (target condicionado: la forma mas honesta de tolerar el autofirmado
  # declarado a proposito, ver la cabecera de `blackbox/blackbox.yml`). Un
  # fichero SIN este job es YAML valido igual: `scrape_configs` sencillamente
  # tiene un elemento menos, y la ausencia de la serie es justo lo que hace
  # que la alerta no dispare en esa instalacion.
@@KRONOQR_UPTIME_TLS_VERIFIED_JOB@@
