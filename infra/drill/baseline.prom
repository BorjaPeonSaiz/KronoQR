# KronoQR — estado SANO de la instalacion simulada (V4-DV-3, make alerts-drill).
#
# Una linea por serie, en formato de exposicion de Prometheus. alerts-drill.sh
# lo publica tal cual por el colector textfile de node-exporter y, para cada
# alerta, lo vuelve a publicar con UNA falla aplicada (faults.tsv): cambiar el
# valor de una serie, o retirarla.
#
# Dos marcas se sustituyen al publicar, para que las comparaciones con time()
# no caduquen mientras corre el simulacro:
#   @NOW@               el instante actual en segundos Unix
#   @NOW-N@ / @NOW+N@   ese instante menos o mas N segundos
#
# Los contadores de aqui arrancan en 0 a proposito: `increase()` necesita una muestra anterior
# para ver el salto. Es una SIMPLIFICACION: en Redis un contador no existe hasta su primer
# incremento, y el producto lo publica ya con valor 1.
#
# LOS QUE ESE DETALLE HARIA ENGANOSOS NO ESTAN AQUI (los de 5xx por familia y el de trabajos
# terminados, cuyas reglas tienen una rama especifica para la serie recien nacida). En Redis un contador no existe hasta su
# primer incremento (p. ej. la serie de 5xx de una ruta, o `queue_job_duration_seconds_count`):
# no se declara un 0 que el producto no publica, y la falla la CREA con `add` (faults.tsv). Asi
# el simulacro ejercita la rama de «serie nacida» de las reglas, que es la que vale el primer dia.
#
# Si una regla nueva lee una serie y esa serie no esta aqui, las alertas de tipo
# `absent()` dispararan en el estado sano y el simulacro lo dira.

# --- Copia de seguridad y WAL (backup.yml) ------------------------------------
kronoqr_backup_last_result{type="daily"} 1
kronoqr_backup_last_verify_result{type="daily"} 1
kronoqr_backup_last_success_timestamp_seconds{type="daily"} @NOW@
kronoqr_backup_last_verified_timestamp_seconds{type="daily"} @NOW@
kronoqr_backup_volume_free_ratio 0.60
kronoqr_backup_restore_drill_last_result 1
kronoqr_backup_restore_drill_last_success_timestamp_seconds @NOW@
kronoqr_wal_exporter_last_run_timestamp_seconds @NOW@
kronoqr_wal_archive_timeout_seconds 900
kronoqr_wal_unarchived_age_seconds 0
kronoqr_wal_unarchived_segments 0
kronoqr_wal_archive_failing 0
kronoqr_wal_replication_slots_inactive 0

# --- Almacen de metricas (metrics-store.yml) ----------------------------------
kronoqr_metrics_store_up 1

# --- Certificado TLS (tls.yml): las dos sondas de blackbox --------------------
probe_success{job="kronoqr-uptime",instance="https://nginx:8443/api/v1/health"} 1
probe_ssl_earliest_cert_expiry{job="kronoqr-uptime",instance="https://nginx:8443/api/v1/health"} @NOW+7776000@
probe_success{job="kronoqr-uptime-tls-verified",instance="https://hotel.drill.invalid/api/v1/health"} 1
probe_ssl_earliest_cert_expiry{job="kronoqr-uptime-tls-verified",instance="https://hotel.drill.invalid/api/v1/health"} @NOW+7776000@

# --- Disco del servidor (host.yml) --------------------------------------------
node_filesystem_size_bytes{mountpoint="/",fstype="ext4",device="/dev/sda1"} 100000000000
node_filesystem_avail_bytes{mountpoint="/",fstype="ext4",device="/dev/sda1"} 60000000000

# --- Quioscos (kiosk.yml) -----------------------------------------------------
kiosk_offline_queue_size{device="drill-kiosk-1"} 0
kiosk_queue_storage_degraded{device="drill-kiosk-1"} 0
kiosk_unreported_discards{device="drill-kiosk-1"} 0
kiosk_discarded_scans_total{device="drill-kiosk-1",attributed="true"} 0
scan_batch_items_not_processed_total 0

# --- Conciliacion del registro (work-record.yml) y proyecciones ---------------
work_record_reconciliation_last_run_timestamp_seconds{scope="recent"} @NOW@
work_record_reconciliation_last_run_timestamp_seconds{scope="full"} @NOW@
projection_reconciliation_last_failures 0
projection_reconciliation_last_run_timestamp_seconds @NOW@

# --- Incidencias y patrones (incidents.yml) -----------------------------------
incidents_open{type="insufficient_rest"} 0
incident_detection_last_failures 0
incident_detection_last_run_timestamp_seconds @NOW@
pattern_detection_last_failures 0
pattern_detection_last_run_timestamp_seconds @NOW@
incidents_metrics_timestamp_seconds @NOW@

# --- Ficheros generados (generated-files.yml) ---------------------------------
generated_files_overdue 0
generated_files_remove_failed_total 0

# --- Cuentas de gestion (management-accounts.yml) -----------------------------
kronoqr_management_account_changes_total{action="created",role="admin"} 0
kronoqr_management_account_changes_total{action="two_factor_reset",role="admin"} 0

# --- Auditoria (audit.yml) ----------------------------------------------------
audit_chain_last_verification_timestamp_seconds @NOW@
audit_chain_verification_failures_total 0
audit_log_partition_ready{horizon="current"} 1
audit_log_partition_ready{horizon="next"} 1

# --- Deteccion de amenazas (threat-detection.yml) -----------------------------
scans_total{result="rejected_signature"} 0
http_requests_total{route="attendance.scan",status="429"} 0

# --- Cola de trabajos y tiempo real (queue.yml, bloque 9 de la 2.3.0) ------------
# Cola vacia y Reverb contestando a la tarea de presencia, que acaba de correr.
queue_jobs_pending{queue="default"} 0
queue_jobs_waiting{queue="default"} 0
presence_metrics_timestamp_seconds @NOW@
websocket_connections_active 2
probe_success{job="kronoqr-loki",instance="http://loki:3100/ready"} 1

# --- 5xx del panel y del portal (api.yml, bloque 9 de la 2.3.0) ------------------
http_requests_total{route="employees.index",status="200"} 100
http_requests_total{route="portal.workdays",status="200"} 100

# --- Latencia del fichaje, una serie por ruta (api.yml, bloque 9 de la 2.3.0) ----
# Los cubos son los del middleware (0,4 s, 1 s, 3 s y +Inf, con las etiquetas `le` que expone el
# producto). Todo el trafico por debajo del primer umbral de cada ruta: el QR vigila 0,5 s
# (interpolado entre 0,4 y 1), el PIN y el lote 3 s. Las reglas aceptan `le` 3 y 3.0.
http_request_duration_seconds_bucket{route="attendance.scan",le="0.4"} 100
http_request_duration_seconds_bucket{route="attendance.scan",le="1.0"} 100
http_request_duration_seconds_bucket{route="attendance.scan",le="+Inf"} 100
http_request_duration_seconds_count{route="attendance.scan"} 100
http_request_duration_seconds_bucket{route="attendance.scan.pin",le="3.0"} 100
http_request_duration_seconds_bucket{route="attendance.scan.pin",le="+Inf"} 100
http_request_duration_seconds_count{route="attendance.scan.pin"} 100
http_request_duration_seconds_bucket{route="attendance.scan.batch",le="3.0"} 100
http_request_duration_seconds_bucket{route="attendance.scan.batch",le="+Inf"} 100
http_request_duration_seconds_count{route="attendance.scan.batch"} 100

# --- Conciliacion completa y fichajes aceptados (work-record.yml, revision del bloque 9) ---
# La pasada completa lee tramos y ha habido fichajes: ConciliacionCompletaSinTramos en silencio.
work_record_reconciliation_entries_checked{scope="full"} 1200
scans_total{result="clock_in"} 100

# --- Las sondas de blackbox-exporter leidas por Prometheus (observability.yml) -------------
# `up` de cada job de sonda: 1 mientras Prometheus consigue leerlas. (En la pila del
# simulacro los publica el colector textfile con `honor_labels`.)
up{job="kronoqr-uptime",instance="https://nginx:8443/api/v1/health"} 1
up{job="kronoqr-loki",instance="http://loki:3100/ready"} 1
